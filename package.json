{
  "name": "gitlab-mr-review",
  "displayName": "GitLab MR Review",
  "description": "GitLab merge requests awaiting my review",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:gitlabMrReview.pendingReviews"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitlabMrReview.refresh",
        "title": "GitLab MR Review: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitlabMrReview.authenticate",
        "title": "GitLab MR Review: Authenticate"
      },
      {
        "command": "gitlabMrReview.logout",
        "title": "GitLab MR Review: Log Out"
      },
      {
        "command": "gitlabMrReview.openFilePatch",
        "title": "GitLab MR Review: Open File Patch"
      },
      {
        "command": "gitlabMrReview.addComment",
        "title": "GitLab MR Review: Add Comment"
      },
      {
        "command": "gitlabMrReview.approve",
        "title": "Approve",
        "icon": "$(check)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitlabMrReview",
          "title": "GitLab Merge Requests",
          "icon": "resources/gitlab.svg"
        }
      ]
    },
    "views": {
      "gitlabMrReview": [
        {
          "id": "gitlabMrReview.pendingReviews",
          "name": "Merge Requests",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitlabMrReview.refresh",
          "when": "view == gitlabMrReview.pendingReviews",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitlabMrReview.approve",
          "when": "view == gitlabMrReview.pendingReviews && viewItem == mergeRequest"
        }
      ],
      "editor/context": [
        {
          "command": "gitlabMrReview.addComment",
          "when": "editorLangId == diff",
          "group": "9_gitlab@1"
        }
      ]
    },
    "configuration": {
      "title": "GitLab MR Review",
      "properties": {
        "gitlabMrReview.url": {
          "type": "string",
          "default": "",
          "description": "GitLab server URL, for example https://gitlab.example.com"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "jest --passWithNoTests"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
