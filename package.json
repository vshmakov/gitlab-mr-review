{
  "name": "gitlab-mr-review",
  "displayName": "GitLab MR Review",
  "description": "GitLab merge requests awaiting my review",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vshmakov/gitlab-mr-review.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "gitlab",
    "merge request",
    "code review",
    "diff",
    "review"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitlabMrReview.refresh",
        "title": "GitLab MR Review: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitlabMrReview.authenticate",
        "title": "GitLab MR Review: Authenticate"
      },
      {
        "command": "gitlabMrReview.logout",
        "title": "GitLab MR Review: Log Out"
      },
      {
        "command": "gitlabMrReview.openFilePatch",
        "title": "GitLab MR Review: Open File Patch"
      },
      {
        "command": "gitlabMrReview.addComment",
        "title": "GitLab MR Review: Add Comment"
      },
      {
        "command": "gitlabMrReview.approve",
        "title": "GitLab MR Review: Approve",
        "icon": "$(check)"
      },
      {
        "command": "gitlabMrReview.markAsReviewed",
        "title": "GitLab MR Review: Mark as Reviewed"
      },
      {
        "command": "gitlabMrReview.unmarkAsReviewed",
        "title": "GitLab MR Review: Mark as Unreviewed"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitlabMrReview",
          "title": "GitLab Merge Requests",
          "icon": "resources/gitlab.svg"
        }
      ]
    },
    "views": {
      "gitlabMrReview": [
        {
          "id": "gitlabMrReview.pendingReviews",
          "name": "Merge Requests",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitlabMrReview.refresh",
          "when": "view == gitlabMrReview.pendingReviews",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitlabMrReview.approve",
          "when": "view == gitlabMrReview.pendingReviews && viewItem == mergeRequest"
        },
        {
          "command": "gitlabMrReview.markAsReviewed",
          "when": "view == gitlabMrReview.pendingReviews && viewItem == mergeRequestFile",
          "group": "1_review"
        },
        {
          "command": "gitlabMrReview.unmarkAsReviewed",
          "when": "view == gitlabMrReview.pendingReviews && viewItem == mergeRequestFile.reviewed",
          "group": "1_review"
        }
      ],
      "editor/context": [
        {
          "command": "gitlabMrReview.addComment",
          "when": "editorLangId == diff",
          "group": "9_gitlab@1"
        }
      ]
    },
    "configuration": {
      "title": "GitLab MR Review",
      "properties": {
        "gitlabMrReview.url": {
          "type": "string",
          "default": "",
          "description": "GitLab server URL, for example https://gitlab.example.com"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "check": "npm run lint && npm run compile && npm test -- --runInBand",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --max-warnings=0",
    "test": "jest --passWithNoTests --testPathIgnorePatterns=tests/contract",
    "test:contract": "jest tests/contract --passWithNoTests",
    "audit": "npm audit --audit-level=high",
    "release:create": "bash ./bin/release-create.sh",
    "release:publish": "bash ./bin/release-publish.sh",
    "rebuild": "npm run compile && npm run test",
    "install-ext": "npm run compile && npm run test && npx vsce package && code --install-extension ./gitlab-mr-review-*.vsix && rm -f *.vsix"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
